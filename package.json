{
  "name": "caja-link",
  "version": "0.1.0",
  "private": true,
  "description": "Interoperabilidad de afiliaciones entre cajas de compensacion",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/main.js",
    "dev": "node --env-file=.env --experimental-strip-types src/main.ts",
    "migrate": "node dist/persistence/migrate.js",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:junit": "node scripts/test-junit.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.3",
    "csv-parse": "7.0.3",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
