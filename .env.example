# Tokens con los que cada caja consumidora se autentica ante su servicio (puerto 8083)
NORTE_TOKEN=cambiar-norte
ORIENTE_TOKEN=cambiar-oriente
CENTRO_TOKEN=cambiar-centro
SUR_TOKEN=cambiar-sur
ADMIN_TOKEN=cambiar-admin

# Credenciales que su servicio usa ante las cajas simuladas
CAJA_NORTE_URL=http://caja-norte:9001
CAJA_NORTE_API_KEY=norte-key
CAJA_ORIENTE_URL=http://caja-oriente:9002/ws/AfiliacionService
CAJA_ORIENTE_USER=caja-link
CAJA_ORIENTE_PASSWORD=oriente-pass
CAJA_CENTRO_DIR=/data/caja-centro
CAJA_SUR_URL=http://caja-sur:9004
CAJA_SUR_TOKEN=sur-token

# Cuarta caja: el validador la activa poniendo true y recreando los servicios
CAJA_SUR_ENABLED=false

# Puertos publicados en el host (cambiar solo si hay conflicto local)
CAJA_NORTE_PORT=9001
CAJA_ORIENTE_PORT=9002
CAJA_SUR_PORT=9004
