# Tokens con los que cada caja consumidora se autentica ante su servicio (puerto 8083)
NORTE_TOKEN=cambiar-norte
ORIENTE_TOKEN=cambiar-oriente
CENTRO_TOKEN=cambiar-centro
SUR_TOKEN=cambiar-sur
ADMIN_TOKEN=cambiar-admin

# Credenciales que su servicio usa ante las cajas simuladas
CAJA_NORTE_URL=http://caja-norte:9001
CAJA_NORTE_API_KEY=cambiar-api-norte
CAJA_ORIENTE_URL=http://caja-oriente:9002/ws/AfiliacionService
CAJA_ORIENTE_USER=caja-link
CAJA_ORIENTE_PASSWORD=cambiar-clave-oriente
CAJA_CENTRO_DIR=/data/caja-centro
CAJA_SUR_URL=http://caja-sur:9004
CAJA_SUR_TOKEN=cambiar-api-sur

# Cuarta caja: el validador la activa poniendo true y recreando los servicios
CAJA_SUR_ENABLED=false

# Puertos publicados en el host (cambiar solo si hay conflicto local)
CAJA_NORTE_PORT=9001
CAJA_ORIENTE_PORT=9002
CAJA_SUR_PORT=9004

# Base propia (el puerto PostgreSQL solo se usa en la red interna de Compose)
PGHOST=postgres
PGPORT=5432
PGDATABASE=caja_link
PGUSER=caja_link
PGPASSWORD=cambiar-postgres
PGPOOL_MAX=10
PGCONNECT_TIMEOUT_MS=1000
PGQUERY_TIMEOUT_MS=1500

# API y configuración (en contenedor; ajustar directorio Centro al ejecutar fuera de Compose)
HOST=0.0.0.0
PORT=8083
CAJAS_CONFIG_PATH=/app/config/cajas.yaml
LOG_LEVEL=info
BODY_LIMIT_BYTES=2097152

# Presupuesto total de consultas, siempre menor de 5000 ms, incluida espera de concurrencia
QUERY_TOTAL_TIMEOUT_MS=4500
ORIGIN_TIMEOUT_MS=3500
QUERY_CONCURRENCY=64
ORIGIN_CONCURRENCY=32
BATCH_CONCURRENCY=16
BATCH_MAX_DOCUMENTS=10000
